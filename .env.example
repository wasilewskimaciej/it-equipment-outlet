# Microsoft Azure AD (optional - leave empty for local testing)
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id

# Local accounts (format: user1:bcrypt_hash1:display_name1:role1,user2:bcrypt_hash2:display_name2:role2)
# role = admin or user
# Generate hash: node -e "console.log(require('bcrypt').hashSync('your-password', 10))"
LOCAL_ACCOUNTS=

# Login security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Session - generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate-64-random-chars-here

# Admin emails (comma separated) - for Microsoft users
ADMIN_EMAILS=admin1@yourcompany.com,admin2@yourcompany.com

# SMTP (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
NOTIFICATION_EMAIL=admin@example.com

# Server
PORT=3000
BASE_URL=http://localhost:3000
