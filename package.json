{
  "name": "it-equipment-outlet",
  "version": "1.0.0",
  "description": "Internal portal for browsing and reserving surplus company IT equipment",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:thumbnails": "node -e \"require('./dist/services/thumbnail').generateAllMissingThumbnails()\""
  },
  "keywords": [],
  "author": "Maciej Wasilewski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wasilewskimaciej/it-equipment-outlet.git"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "better-sqlite3-session-store": "^0.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "multer": "^2.3.0",
    "nodemailer": "^9.0.6",
    "passport": "^0.7.0",
    "passport-azure-ad": "^4.3.5",
    "passport-local": "^1.0.0",
    "sharp": "^0.35.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-azure-ad": "^4.3.6",
    "@types/passport-local": "^1.0.38",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
